[Unit]
Description=Render and push every tronbyt display from one shared snapshot
After=network-online.target docker.service

[Service]
Type=oneshot
User=robwil
# pixlet lives in /usr/local/bin, which is not on the default unit PATH
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/stack/tidbyt/tick.sh
