{
 "uid": "battery",
 "title": "Battery & foxctl",
 "tags": [
  "energy",
  "foxess",
  "foxctl"
 ],
 "timezone": "Australia/Sydney",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "graphTooltip": 1,
 "time": {
  "from": "now-48h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "State of charge",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-ha"
   },
   "gridPos": {
    "w": 24,
    "h": 9,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "SoC",
     "query": "SELECT mean(\"value\") FROM \"%\" WHERE \"entity_id\" = 'foxess_foxctl_battery_soc' AND $timeFilter GROUP BY time($__interval) fill(null)"
    },
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Target",
     "query": "SELECT last(\"value\") FROM \"%\" WHERE \"entity_id\" = 'foxess_foxctl_target_soc' AND time > ${__from}ms - 30d AND time < ${__to}ms GROUP BY time($__interval) fill(previous)"
    },
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Coast margin",
     "query": "SELECT mean(\"value\") FROM \"%\" WHERE \"entity_id\" = 'battery_coast_margin' AND $timeFilter GROUP BY time($__interval) fill(null)"
    },
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Min SoC",
     "query": "SELECT last(\"value\") FROM \"%\" WHERE \"entity_id\" = 'min_soc' AND time > ${__from}ms - 30d AND time < ${__to}ms GROUP BY time($__interval) fill(previous)"
    },
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Max SoC",
     "query": "SELECT last(\"value\") FROM \"%\" WHERE \"entity_id\" = 'max_soc' AND time > ${__from}ms - 30d AND time < ${__to}ms GROUP BY time($__interval) fill(previous)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 2,
   "type": "state-timeline",
   "title": "Work mode",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-ha"
   },
   "gridPos": {
    "w": 24,
    "h": 4,
    "x": 0,
    "y": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Work mode",
     "query": "SELECT \"state\" FROM \"state\" WHERE \"entity_id\" = 'work_mode' AND $timeFilter"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 70,
      "lineWidth": 0
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "auto",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
