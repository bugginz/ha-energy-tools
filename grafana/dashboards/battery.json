     "alias": "Charge",
     "query": "SELECT spread(\"value\") FROM \"kWh\" WHERE \"entity_id\" = 'foxess_foxctl_battery_charge_energy' AND $timeFilter GROUP BY time(1d) fill(none) tz('Australia/Sydney')"
