    },
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Grid-upload slider",
     "query": "SELECT last(\"value\") FROM \"kW\" WHERE \"entity_id\" = 'grid_upload_kw' AND time > ${__from}ms - 30d AND time < ${__to}ms GROUP BY time($__interval) fill(previous)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatt",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 5,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
