     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "5-min",
     "query": "SELECT mean(\"value\") FROM \"$/kWh\" WHERE \"entity_id\" = 'aemo_nem_nsw1_current_5min_period_price' AND $timeFilter GROUP BY time($__interval) fill(null)"
