   "id": 1,
   "type": "timeseries",
   "title": "Living room",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-ha"
   },
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Room",
     "query": "SELECT mean(\"value\") FROM \"\u00b0C\" WHERE \"entity_id\" = 'living_room_ac_ac_home' AND $timeFilter GROUP BY time($__interval) fill(null)"
    },
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Target",
     "query": "SELECT last(\"value\") FROM \"\u00b0C\" WHERE \"entity_id\" = 'living_room_ac_ac_target' AND time > ${__from}ms - 30d AND time < ${__to}ms GROUP BY time($__interval) fill(previous)"
    },
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Outside unit",
     "query": "SELECT last(\"value\") FROM \"\u00b0C\" WHERE \"entity_id\" = 'living_room_ac_outside' AND time > ${__from}ms - 30d AND time < ${__to}ms GROUP BY time($__interval) fill(previous)"
    },
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Compressor Hz",
     "query": "SELECT last(\"value\") FROM \"Hz\" WHERE \"entity_id\" = 'living_room_ac_comp' AND time > ${__from}ms - 30d AND time < ${__to}ms GROUP BY time($__interval) fill(previous)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Compressor Hz"
      },
      "properties": [
       {
        "id": "unit",
        "value": "rothz"
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
