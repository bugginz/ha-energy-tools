  {
   "id": 5,
   "type": "timeseries",
   "title": "Daily cost (GloBird)",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-ha"
   },
   "gridPos": {
    "w": 24,
    "h": 8,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Daily cost",
     "query": "SELECT last(\"value\") FROM \"AUD\" WHERE \"entity_id\" = 'globird_energy_latest_daily_cost' AND $timeFilter GROUP BY time($__interval) fill(null)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 6,
   "type": "barchart",
   "title": "GloBird metered per day",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-ha"
   },
   "gridPos": {
    "w": 24,
    "h": 8,
    "x": 0,
    "y": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Usage",
     "query": "SELECT last(\"value\") FROM \"kWh\" WHERE \"entity_id\" = 'globird_energy_latest_day_usage' AND $timeFilter GROUP BY time($__interval) fill(null)"
    },
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "Solar export",
     "query": "SELECT last(\"value\") FROM \"kWh\" WHERE \"entity_id\" = 'globird_energy_latest_day_solar_export' AND $timeFilter GROUP BY time($__interval) fill(null)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "decimals": 1,
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "vertical",
    "stacking": "none",
    "xTickLabelRotation": -45,
    "showValue": "never",
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "transformations": [
    {
     "id": "formatTime",
     "options": {
      "timeField": "Time",
      "outputFormat": "ddd D MMM"
     }
    }
   ]
  }
 ],
