{
 "uid": "costs",
 "title": "Costs",
 "tags": [
  "energy",
  "globird"
 ],
 "timezone": "Australia/Sydney",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "graphTooltip": 1,
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Latest daily cost",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-ha"
   },
   "gridPos": {
    "w": 4,
    "h": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-ha"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "cost",
     "query": "SELECT last(\"value\") FROM \"AUD\" WHERE \"entity_id\" = 'globird_energy_latest_daily_cost' AND $timeFilter"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
